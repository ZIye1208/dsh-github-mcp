{
  "name": "dsh-github-mcp",
  "description": "DSH 插件：GitHub MCP 连接插件。token、工具集与只读开关都存在 DSH 凭据中心(.credentials.yaml)，在「设置 → GitHub MCP」里改，改完自动重连；提供 GitHub 工具(mcp__github__*)。可选捆绑安装面板插件 dsh-github-mcp-hint。",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/preview.png",
    "docs/settings.png",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "optionalDependencies": {
    "dsh-github-mcp-hint": "^0.3.1"
  },
  "devDependencies": {
    "yaml": "^2.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIye1208/dsh-github-mcp.git"
  },
  "license": "MIT"
}
