{
  "name": "dsh-github-mcp",
  "description": "把 GitHub 官方 MCP server 接进 DSH：token 存凭据中心，工具集/只读/serverName 由 Settings 管理，改完自动重连；工具以 mcp__<serverName>__* 提供。/ GitHub's official MCP server for DSH — token stays in credentials, while toolsets/read-only/serverName are managed in Settings with auto-reconnect; tools exposed as mcp__<serverName>__*.",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "screenshots.json",
    "docs/settings.png",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.2.3-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "yaml": "^2.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIye1208/dsh-github-mcp.git"
  },
  "license": "MIT"
}
