{
  "name": "dsh-github-mcp",
  "description": "把 GitHub 官方 MCP server 接进 DSH：token、工具集与只读开关都在「设置 → GitHub MCP」里改，值存 DSH 凭据中心，改完自动重连；工具以 mcp__github__* 提供。/ GitHub's official MCP server for DSH — token, toolsets and read-only mode live in Settings → GitHub MCP, stored in the credential store with auto-reconnect; tools exposed as mcp__github__*.",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "screenshots.json",
    "docs/settings.png",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.1.0 || >=4.1.0-rc.0 <5.0.0-0"
  },
  "optionalDependencies": {
    "dsh-github-mcp-hint": "^0.3.1"
  },
  "devDependencies": {
    "yaml": "^2.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIye1208/dsh-github-mcp.git"
  },
  "license": "MIT"
}
